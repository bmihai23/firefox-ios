/* When the user uses the summarizing feature, this is the loading label that is shown while the summarization is being performed. */
"Summarizer.Loading.Label.v142" = "Geri samantekt…";

/* The label for the error button that allows the user to retry summarizing the page. */
"Summarizer.RetryButton.Label.v142" = "Reyna aftur";

/* The label for the allow button on the ToS alert. */
"Summarizer.ToS.Alert.AllowButton.Label.v142" = "Leyfa";

/* The message for the ToS alert that asks the user if they want to allow page summaries with Apple Intelligence. %@ is the app name (e.g Firefox). */
